{
  "name": "@yijie/skills",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "lint": "node scripts/lint-skills.mjs && node scripts/validate-package.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/run-evals.mjs",
    "package": "node scripts/package-desktop-skills.mjs",
    "package:desktop": "node scripts/package-desktop-skills.mjs",
    "package:desktop-release": "node scripts/package-desktop-skills.mjs --channel desktop-release --output dist/skill-packages-desktop-release",
    "eval": "node scripts/run-evals.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "smol-toml": "1.7.0"
  }
}
